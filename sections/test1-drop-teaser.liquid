{{ 'component-test1-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-test1-drop-teaser.css' | asset_url | stylesheet_tag }}
{% render 'test1-fonts' %}

{%- liquid
  assign pattern_image = section.settings.pattern_image
  assign right_image = section.settings.right_image

  assign now_ts = 'now' | date: '%s' | plus: 0
  assign target_ts = section.settings.target_date | date: '%s'
  if target_ts == blank
    assign target_ts = now_ts
  else
    assign target_ts = target_ts | plus: 0
  endif
  assign diff = target_ts | minus: now_ts
  if diff < 0
    assign diff = 0
  endif
  assign init_days = diff | divided_by: 86400
  if init_days > 99
    assign init_days = 99
  endif
  assign remainder_after_days = diff | modulo: 86400
  assign init_hours = remainder_after_days | divided_by: 3600
  assign remainder_after_hours = remainder_after_days | modulo: 3600
  assign init_minutes = remainder_after_hours | divided_by: 60
  assign is_ended = false
  if diff <= 0
    assign is_ended = true
  endif

  if pattern_image
    assign pattern_image_url = pattern_image | image_url: width: 1400
  else
    assign pattern_image_url = 'test1-drop-pattern.png' | asset_url
  endif
-%}

{% style %}
  #Test1Drop-{{ section.id }} .test1-drop__panel--left {
    background-image: url({{ pattern_image_url }});
  }
{% endstyle %}

<section id="Test1Drop-{{ section.id }}" class="test1-drop" aria-label="Drop teaser">
  <div class="test1-drop__panel test1-drop__panel--left">
    <p class="test1-drop__eyebrow">
      {{ section.settings.eyebrow | default: 'New drop coming soon' }}
      <span aria-hidden="true">&#9825;</span>
    </p>

    <countdown-timer
      class="test1-countdown"
      role="timer"
      aria-label="{{ 'Time remaining until the drop' | escape }}"
      aria-live="off"
      data-target="{{ section.settings.target_date }}"
      data-ended-id="Test1DropEnded-{{ section.id }}"
      {% if is_ended %}hidden{% endif %}
    >
      <span class="visually-hidden" data-countdown-live>
        {{ init_days }} days, {{ init_hours }} hours, {{ init_minutes }} minutes remaining
      </span>
      <div class="test1-countdown__group" aria-hidden="true">
        <div class="test1-countdown__tiles" data-unit="days">
          <span>{{ init_days | modulo: 100 | divided_by: 10 }}</span><span>{{ init_days | modulo: 10 }}</span>
        </div>
        <small>Days</small>
      </div>
      <span class="test1-countdown__colon" aria-hidden="true">:</span>
      <div class="test1-countdown__group" aria-hidden="true">
        <div class="test1-countdown__tiles" data-unit="hours">
          <span>{{ init_hours | modulo: 100 | divided_by: 10 }}</span><span>{{ init_hours | modulo: 10 }}</span>
        </div>
        <small>Hours</small>
      </div>
      <span class="test1-countdown__colon" aria-hidden="true">:</span>
      <div class="test1-countdown__group" aria-hidden="true">
        <div class="test1-countdown__tiles" data-unit="minutes">
          <span>{{ init_minutes | modulo: 100 | divided_by: 10 }}</span><span>{{ init_minutes | modulo: 10 }}</span>
        </div>
        <small>Minutes</small>
      </div>
    </countdown-timer>

    <div id="Test1DropEnded-{{ section.id }}" class="test1-countdown__ended" {% unless is_ended %}hidden{% endunless %}>
      {%- if section.settings.ended_message != blank -%}
        {{ section.settings.ended_message }}
      {%- else -%}
        It's here — shop the drop now.
      {%- endif -%}
      {%- if section.settings.ended_button_label != blank and section.settings.ended_button_collection != blank -%}
        <br>
        <a class="test1-btn test1-btn--pill" href="{{ section.settings.ended_button_collection.url }}">
          {{ section.settings.ended_button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="test1-drop__panel test1-drop__panel--right">
    <div class="test1-drop__image-wrap">
      {%- if right_image -%}
        <img
          class="test1-drop__image"
          srcset="
            {%- if right_image.width >= 375 -%}{{ right_image | image_url: width: 375 }} 375w,{%- endif -%}
            {%- if right_image.width >= 750 -%}{{ right_image | image_url: width: 750 }} 750w,{%- endif -%}
            {{ right_image | image_url }} {{ right_image.width }}w
          "
          sizes="(min-width: 750px) 50vw, 100vw"
          src="{{ right_image | image_url: width: 750 }}"
          alt="{{ right_image.alt | default: '' | escape }}"
          width="{{ right_image.width }}"
          height="{{ right_image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <img
          class="test1-drop__image"
          src="{{ 'test1-drop-right.jpg' | asset_url }}"
          alt=""
          width="720"
          height="335"
          loading="lazy"
        >
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <p class="test1-drop__caption">{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>

    {%- assign form_id = 'Test1DropNotify-' | append: section.id -%}
    {% form 'customer', id: form_id, class: 'test1-notify' %}
      <input type="hidden" name="contact[tags]" value="newsletter,drop-teaser">
      <label class="test1-notify__label" for="{{ form_id }}-email">
        {{ section.settings.form_label | default: 'Get notified' }}
      </label>
      <div class="test1-notify__row">
        <input
          class="test1-notify__input"
          type="email"
          id="{{ form_id }}-email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.email_placeholder | default: 'user@gmail.com' }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="{{ form_id }}-error"
          {% elsif form.posted_successfully? %}
            aria-describedby="{{ form_id }}-success"
          {% endif %}
        >
        <button class="test1-notify__btn" type="submit">
          {{ section.settings.button_label | default: 'Notify me' }}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p
          class="test1-notify__msg test1-notify__msg--success"
          id="{{ form_id }}-success"
          role="status"
          tabindex="-1"
        >
          {{ section.settings.success_message | default: "You're on the list — thanks!" }}
        </p>
      {%- elsif form.errors -%}
        <p
          class="test1-notify__msg test1-notify__msg--error"
          id="{{ form_id }}-error"
          role="alert"
          tabindex="-1"
        >
          {{ section.settings.error_message | default: 'Something went wrong. Please try again.' }}
        </p>
      {%- endif -%}
    {% endform %}
  </div>
</section>

<script src="{{ 'test1-countdown.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Drop teaser",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Left panel"
    },
    {
      "type": "image_picker",
      "id": "pattern_image",
      "label": "Background pattern",
      "info": "Uses a default pattern when empty."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script headline",
      "default": "New drop coming soon"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Countdown target date and time",
      "default": "2026-10-01T00:00",
      "info": "24-hour format, in your store's timezone: YYYY-MM-DDTHH:MM (e.g. 2026-10-01T09:00)."
    },
    {
      "type": "text",
      "id": "ended_message",
      "label": "Message shown once the countdown ends",
      "default": "It's here — shop the drop now."
    },
    {
      "type": "text",
      "id": "ended_button_label",
      "label": "Button label after the countdown ends",
      "info": "Optional. Shown together with the collection below."
    },
    {
      "type": "collection",
      "id": "ended_button_collection",
      "label": "Button collection after the countdown ends"
    },
    {
      "type": "header",
      "content": "Right panel"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Image",
      "info": "Uses a default image when empty."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Script caption",
      "default": "Sneak peek…"
    },
    {
      "type": "header",
      "content": "Email capture"
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Form label",
      "default": "Get notified"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email field placeholder",
      "default": "user@gmail.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're on the list — thanks!"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Something went wrong. Please try again."
    }
  ],
  "presets": [
    {
      "name": "Drop teaser"
    }
  ]
}
{% endschema %}
