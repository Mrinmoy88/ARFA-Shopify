{{ 'component-test1-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-test1-hero.css' | asset_url | stylesheet_tag }}
{% render 'test1-fonts' %}

{%- liquid
  assign bg_image = section.settings.background_image
  assign show_headline_image = false
  if section.settings.headline_style == 'image'
    assign show_headline_image = true
  endif
-%}

<section class="test1-hero" aria-label="{{ section.settings.headline_text | default: 'Hero' | escape }}">
  {%- if bg_image -%}
    <img
      class="test1-hero__bg"
      srcset="
        {%- if bg_image.width >= 750 -%}{{ bg_image | image_url: width: 750 }} 750w,{%- endif -%}
        {%- if bg_image.width >= 1100 -%}{{ bg_image | image_url: width: 1100 }} 1100w,{%- endif -%}
        {%- if bg_image.width >= 1440 -%}{{ bg_image | image_url: width: 1440 }} 1440w,{%- endif -%}
        {%- if bg_image.width >= 2000 -%}{{ bg_image | image_url: width: 2000 }} 2000w,{%- endif -%}
        {{ bg_image | image_url }} {{ bg_image.width }}w
      "
      sizes="100vw"
      src="{{ bg_image | image_url: width: 1440 }}"
      alt="{{ bg_image.alt | default: '' | escape }}"
      width="{{ bg_image.width }}"
      height="{{ bg_image.height }}"
      loading="eager"
      fetchpriority="high"
    >
  {%- else -%}
    <img
      class="test1-hero__bg"
      src="{{ 'test1-hero-bg.jpg' | asset_url }}"
      alt=""
      width="1440"
      height="810"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}

  <div class="test1-hero__content">
    <h1 class="test1-hero__headline">
      {%- if show_headline_image -%}
        {%- if section.settings.headline_image -%}
          <img
            class="test1-hero__wordmark"
            src="{{ section.settings.headline_image | image_url: width: 800 }}"
            alt="{{ section.settings.headline_text | default: section.settings.headline_image.alt | escape }}"
            width="{{ section.settings.headline_image.width }}"
            height="{{ section.settings.headline_image.height }}"
            loading="eager"
          >
        {%- else -%}
          <img
            class="test1-hero__wordmark"
            src="{{ 'test1-hero-wordmark.svg' | asset_url }}"
            alt="{{ section.settings.headline_text | escape }}"
            width="391"
            height="109"
            loading="eager"
          >
        {%- endif -%}
      {%- else -%}
        <span class="test1-hero__headline-text">{{ section.settings.headline_text }}</span>
      {%- endif -%}
    </h1>

    {%- if section.settings.button_label != blank -%}
      <a
        class="test1-btn test1-btn--pill"
        href="{% if section.settings.button_collection %}{{ section.settings.button_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
      >
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.show_reviews_tab -%}
    <a class="test1-hero__reviews" href="{{ section.settings.reviews_link | default: '#' }}">
      {{- section.settings.reviews_label | default: 'Reviews' | escape -}}
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Full-bleed background, 1440 x 810px recommended. Uses a default image when empty."
    },
    {
      "type": "select",
      "id": "headline_style",
      "label": "Headline",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "text", "label": "Text" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "headline_image",
      "label": "Headline image",
      "info": "Used when headline is set to \"Image\". Uses a default wordmark when empty."
    },
    {
      "type": "text",
      "id": "headline_text",
      "label": "Headline text",
      "default": "Spring Break",
      "info": "Used when headline is set to \"Text\", and as alt text for the headline image."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "collection",
      "id": "button_collection",
      "label": "Button collection",
      "info": "Where the button sends customers."
    },
    {
      "type": "header",
      "content": "Reviews tab"
    },
    {
      "type": "checkbox",
      "id": "show_reviews_tab",
      "label": "Show reviews tab",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_label",
      "label": "Reviews tab label",
      "default": "Reviews"
    },
    {
      "type": "url",
      "id": "reviews_link",
      "label": "Reviews tab link",
      "info": "Point this at your reviews app or page. Leave empty to keep the tab as a visual element only."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
